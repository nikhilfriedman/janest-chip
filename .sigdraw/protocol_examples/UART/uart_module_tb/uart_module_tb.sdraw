      "role": "initial",
      "title": "initial",
      "code": "initial begin\n        CLK = 0;\n        RST = 1;\n        TX  = 1; // idle high\n\n        #10;\n        RST = 0; // reset DUT\n        #10;\n\n        send_uart_byte(8'hA5);\n        send_uart_byte(8'h47);\n        send_uart_byte(8'h80);\n        send_uart_byte(8'hF0);\n        send_uart_byte(8'h01);\n        send_uart_byte(8'h2F);\n        send_uart_byte(8'hA2);\n        send_uart_byte(8'hC1);\n        send_uart_byte(8'h64);\n\n        #(BIT_PERIOD * 2);\n\n\n\n        $finish;\n    end",
