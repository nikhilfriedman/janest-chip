    {
      "type": "code",
      "id": 20,
      "x": 2641.0,
      "y": 867.75,
      "z": 0,
      "width": 756.0,
      "height": 526.0,
      "color": [
        1.0,
        0.88,
        0.78,
        1.0
      ],
      "role": "ff",
      "title": "next_receive_ff",
      "code": "always_ff @(posedge CLK, posedge RST) begin: next_receive_ff\n        if (RST == 1'b1) begin\n            baud_counter <= 'b0;\n\n            r_state <= IDLE;\n            \n            data <= 'b0;\n            receive_counter <= 'b0;\n\n            stop_counter <= 'b0;\n        end else begin\n            baud_counter <= baud_counter_next;\n\n            r_state <= r_next_state;\n            data <= data_next;\n            receive_counter <= receive_counter_next;\n            stop_counter <= stop_counter_next;\n        end\n    end",
      "block_kind": "flip_flop",
      "input_port_ids": [
